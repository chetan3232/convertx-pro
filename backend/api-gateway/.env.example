# ConvertX Pro - API Gateway Configuration Template
# Copy this file to '.env' and fill in your actual credentials before running.

PORT=5000

# Supabase Credentials (required for transient file downloads and authorization)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-actual-anon-key-here

# Redis Broker URL (Optional: defaults to local memory queue if offline)
REDIS_URL=redis://127.0.0.1:6379
